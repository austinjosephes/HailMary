# ==============================================================================
# അമ്മയോടൊപ്പം | CLC Velappaya - Environment Configuration Example
# Copy this file to .env for local development or set in Vercel Project Settings
# ==============================================================================

# Database Connection URL (PostgreSQL - Neon, Supabase, Vercel Postgres, Railway)
# If left blank, the app will automatically use local persistent file storage for development
DATABASE_URL=postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_secret_password_in_production

# Secret key for signing admin session tokens (at least 32 random characters)
SESSION_SECRET=generate_a_random_32_character_secret_key_here

# Local Development Port (Default: 8000)
PORT=8000
